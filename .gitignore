# Dependencies
node_modules/

# Build output
dist/
packages/*/dist/
*.tsbuildinfo
*.d.ts.map

# Test coverage
coverage/

# Rollprobe working directory (events, bundles, reports produced by runs)
.rollprobe/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment files (sensitive data)
.env
.env.local
.env.*.local
*.key
*.pem
*.cert
*.secret

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Temporary files
tmp/
temp/
.cache/
.eslintcache

# OS-specific
Thumbs.db
Desktop.ini

# Local takeover scratch space (generated artefacts kept for auditability, not source)
.control/artifacts_backup/
.tmp/

# Private local agent/audit records - never publish
.control/
